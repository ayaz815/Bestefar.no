# Copy this file to .env and fill in the real values.
# The .env file is read by httpd.www/index.php and is never committed.

# Database
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Outgoing mail (SMTP)
SMTP_HOST=mailout.one.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASS=your_mail_password
SMTP_CRYPTO=tls
SMTP_FROM_EMAIL=support@example.com
SMTP_FROM_NAME=Bestefar.no

# CodeIgniter encryption key (leave blank if not used)
ENCRYPTION_KEY=
